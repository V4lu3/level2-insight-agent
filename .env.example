# =====================================================================
# Level2-Insight Agent - Environment Variables Template
# Copy this file to .env and configure your LLM API parameters
# =====================================================================

# OpenAI / DeepSeek / Qwen / SiliconFlow / Agnes-AI API Key
OPENAI_API_KEY=your_api_key_here

# API Base URL (OpenAI-compatible)
# e.g., https://api.deepseek.com/v1 or https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Target Model Identifier
# e.g., deepseek-chat, gpt-4o-mini, qwen-plus
LLM_MODEL=gpt-4o-mini
